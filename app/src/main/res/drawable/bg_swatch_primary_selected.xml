<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2dp"
                android:color="@color/lifelab_primary" />
        </shape>
    </item>
    <item
        android:bottom="5dp"
        android:end="5dp"
        android:start="5dp"
        android:top="5dp">
        <shape android:shape="oval">
            <solid android:color="@color/lifelab_primary" />
        </shape>
    </item>
</layer-list>
