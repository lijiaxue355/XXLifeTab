<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lifelab_background">

    <include
        android:id="@+id/metrics_editor_toolbar"
        layout="@layout/view_editor_toolbar"
        android:layout_width="0dp"
        android:layout_height="58dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/metrics_editor_steps"
        layout="@layout/view_editor_steps_metrics"
        android:layout_width="0dp"
        android:layout_height="66dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/metrics_editor_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/metrics_action_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/metrics_editor_steps">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="14dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/metrics_heading"
                android:textColor="@color/lifelab_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/metrics_subheading"
                android:textColor="@color/lifelab_text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:id="@+id/intervention_metric_color"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="19dp"
                        android:background="@drawable/bg_swatch_success"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/intervention_metric_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/metric_intervention_done"
                        android:textColor="@color/lifelab_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/intervention_metric_type"
                        app:layout_constraintStart_toEndOf="@id/intervention_metric_color"
                        app:layout_constraintTop_toTopOf="@id/intervention_metric_color" />

                    <TextView
                        android:id="@+id/intervention_metric_type"
                        android:layout_width="88dp"
                        android:layout_height="26dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_neutral_chip"
                        android:gravity="center"
                        android:text="@string/metric_type_switch"
                        android:textColor="@color/lifelab_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="40dp"
                        android:layout_marginBottom="18dp"
                        android:text="@string/metric_yes_no"
                        android:textColor="@color/lifelab_text_secondary"
                        android:textSize="11sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="18dp"
                        android:text="@string/required"
                        android:textColor="@color/lifelab_primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:id="@+id/latency_metric_color"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="19dp"
                        android:background="@drawable/bg_swatch_info"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/metric_sleep_latency"
                        android:textColor="@color/lifelab_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/latency_metric_type"
                        app:layout_constraintStart_toEndOf="@id/latency_metric_color"
                        app:layout_constraintTop_toTopOf="@id/latency_metric_color" />

                    <TextView
                        android:id="@+id/latency_metric_type"
                        android:layout_width="88dp"
                        android:layout_height="26dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_neutral_chip"
                        android:gravity="center"
                        android:text="@string/metric_type_duration"
                        android:textColor="@color/lifelab_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="40dp"
                        android:layout_marginBottom="18dp"
                        android:text="@string/metric_sleep_latency_detail"
                        android:textColor="@color/lifelab_text_secondary"
                        android:textSize="11sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="18dp"
                        android:text="@string/required"
                        android:textColor="@color/lifelab_primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:id="@+id/duration_metric_color"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="19dp"
                        android:background="@drawable/bg_progress_fill"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/metric_sleep_duration"
                        android:textColor="@color/lifelab_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/duration_metric_type"
                        app:layout_constraintStart_toEndOf="@id/duration_metric_color"
                        app:layout_constraintTop_toTopOf="@id/duration_metric_color" />

                    <TextView
                        android:id="@+id/duration_metric_type"
                        android:layout_width="88dp"
                        android:layout_height="26dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_neutral_chip"
                        android:gravity="center"
                        android:text="@string/metric_type_decimal"
                        android:textColor="@color/lifelab_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="40dp"
                        android:layout_marginBottom="18dp"
                        android:text="@string/metric_sleep_duration_detail"
                        android:textColor="@color/lifelab_text_secondary"
                        android:textSize="11sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="18dp"
                        android:text="@string/required"
                        android:textColor="@color/lifelab_primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:id="@+id/energy_metric_color"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="19dp"
                        android:background="@drawable/bg_swatch_rose"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/metric_morning_energy"
                        android:textColor="@color/lifelab_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/energy_metric_type"
                        app:layout_constraintStart_toEndOf="@id/energy_metric_color"
                        app:layout_constraintTop_toTopOf="@id/energy_metric_color" />

                    <TextView
                        android:id="@+id/energy_metric_type"
                        android:layout_width="88dp"
                        android:layout_height="26dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_neutral_chip"
                        android:gravity="center"
                        android:text="@string/metric_type_score"
                        android:textColor="@color/lifelab_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="40dp"
                        android:layout_marginBottom="18dp"
                        android:text="@string/metric_morning_energy_detail"
                        android:textColor="@color/lifelab_text_secondary"
                        android:textSize="11sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="18dp"
                        android:text="@string/required"
                        android:textColor="@color/lifelab_primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="18dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="@string/add_metric"
                android:textAllCaps="false"
                android:textColor="@color/lifelab_primary_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/lifelab_primary_surface"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_plus_primary"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/lifelab_primary_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="@string/metric_count"
                android:textColor="@color/lifelab_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/metrics_action_bar"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:background="@color/lifelab_background"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingTop="4dp"
        android:paddingEnd="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/metrics_previous_button"
            android:layout_width="98dp"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:text="@string/previous_step"
            android:textAllCaps="false"
            android:textColor="@color/lifelab_primary_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/white"
            app:cornerRadius="14dp"
            app:strokeColor="@color/lifelab_divider"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/metrics_next_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:text="@string/next_preview"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/lifelab_primary"
            app:cornerRadius="14dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
