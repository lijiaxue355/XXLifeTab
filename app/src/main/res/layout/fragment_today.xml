<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".feature.today.TodayFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/today_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/lifelab_background"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="18dp"
            android:paddingEnd="22dp"
            android:paddingBottom="20dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="58dp">

                <TextView
                    android:id="@+id/greeting_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:text="@string/today_greeting"
                    android:textColor="@color/lifelab_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/offline_badge"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/today_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@string/today_date"
                    android:textColor="@color/lifelab_text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/greeting_title" />

                <TextView
                    android:id="@+id/offline_badge"
                    android:layout_width="94dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_info_chip"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="@string/offline_available"
                    android:textColor="@color/lifelab_info_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/lifelab_primary"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="20dp"
                    android:paddingEnd="18dp">

                    <TextView
                        android:id="@+id/progress_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/today_progress"
                        android:textColor="@color/lifelab_primary_surface_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.22"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/progress_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/today_progress_count"
                        android:textColor="@color/white"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/progress_label"
                        app:layout_constraintVertical_bias="0.2" />

                    <TextView
                        android:id="@+id/progress_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/today_progress_description"
                        android:textColor="@color/lifelab_primary_surface_text"
                        android:textSize="13sp"
                        app:layout_constraintBaseline_toBaselineOf="@id/progress_count"
                        app:layout_constraintStart_toEndOf="@id/progress_count" />

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="50"
                            app:indicatorColor="@color/white"
                            app:indicatorDirectionCircular="clockwise"
                            app:indicatorInset="0dp"
                            app:indicatorSize="64dp"
                            app:trackColor="@color/lifelab_primary_track"
                            app:trackThickness="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                            android:text="@string/today_progress_percent"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@string/active_experiments"
                    android:textColor="@color/lifelab_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/view_all_experiments"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:fontFamily="sans-serif"
                    android:gravity="bottom"
                    android:paddingStart="16dp"
                    android:paddingEnd="0dp"
                    android:paddingBottom="1dp"
                    android:text="@string/view_all"
                    android:textColor="@color/lifelab_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/active_experiment_card"
                android:layout_width="match_parent"
                android:layout_height="194dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_primary_accent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/intervention_badge"
                        android:layout_width="76dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="22dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_primary_chip"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="@string/intervention_phase"
                        android:textColor="@color/lifelab_primary_dark"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/day_badge"
                        android:layout_width="94dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_info_chip"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="@string/day_ten_of_fourteen"
                        android:textColor="@color/lifelab_info_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/intervention_badge"
                        app:layout_constraintTop_toTopOf="@id/intervention_badge" />

                    <TextView
                        android:id="@+id/active_experiment_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="22dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="20dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="@string/experiment_phone_free"
                        android:textColor="@color/lifelab_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/intervention_badge" />

                    <TextView
                        android:id="@+id/recording_prompt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="22dp"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/tonight_metrics"
                        android:textColor="@color/lifelab_text_secondary"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/active_experiment_title" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/experiment_progress_track"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="22dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="22dp"
                        android:background="@drawable/bg_progress_track"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/recording_prompt">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_progress_fill"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_percent="0.71" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="22dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="8dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="@string/metric_preview"
                        android:textColor="@color/lifelab_text_secondary"
                        android:textSize="11sp"
                        app:layout_constraintEnd_toStartOf="@id/start_recording_button"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/experiment_progress_track" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/start_recording_button"
                        android:layout_width="108dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="22dp"
                        android:layout_marginBottom="13dp"
                        android:fontFamily="sans-serif"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="@string/start_recording"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/lifelab_primary"
                        app:cornerRadius="14dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <androidx.fragment.app.FragmentContainerView
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:id="@+id/fragmentContainerView"
                        android:name="androidx.navigation.fragment.NavHostFragment"
                        android:layout_width="357dp"
                        android:layout_height="11dp"
                        app:defaultNavHost="true"
                        app:navGraph="@navigation/navigation_graph_lab"
                        tools:layout_editor_absoluteX="9dp"
                        tools:layout_editor_absoluteY="182dp" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_success_accent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/baseline_badge"
                        android:layout_width="76dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="22dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_info_chip"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="@string/baseline_phase"
                        android:textColor="@color/lifelab_info_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/completed_badge"
                        android:layout_width="72dp"
                        android:layout_height="26dp"
                        android:layout_marginTop="18dp"
                        android:layout_marginEnd="18dp"
                        android:background="@drawable/bg_success_chip"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="@string/completed_today"
                        android:textColor="@color/lifelab_success_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/walk_experiment_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="22dp"
                        android:layout_marginTop="7dp"
                        android:layout_marginEnd="20dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="@string/experiment_walk"
                        android:textColor="@color/lifelab_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/baseline_badge" />

                    <TextView
                        android:id="@+id/walk_experiment_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="22dp"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/day_four_of_ten"
                        android:textColor="@color/lifelab_text_secondary"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/walk_experiment_title" />

                    <View
                        android:id="@+id/completed_divider"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginStart="22dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="22dp"
                        android:background="@color/lifelab_divider"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/walk_experiment_status" />

                    <TextView
                        android:id="@+id/edit_today_record"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="22dp"
                        android:layout_marginEnd="13dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:text="@string/edit_today_record"
                        android:textColor="@color/lifelab_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:drawableEndCompat="@drawable/ic_chevron_right"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/completed_divider" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/report_card"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/lifelab_info_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/report_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="20dp"
                        android:contentDescription="@string/report_icon_description"
                        android:src="@drawable/ic_trend"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/report_title" />

                    <TextView
                        android:id="@+id/report_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="20dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/report_updated"
                        android:textColor="@color/lifelab_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/report_icon"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/report_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="18dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="@string/report_summary"
                        android:textColor="@color/lifelab_text_secondary"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/report_title"
                        app:layout_constraintTop_toBottomOf="@id/report_title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/personal_observation_only"
                        android:textColor="@color/lifelab_info_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="@id/report_title"
                        app:layout_constraintTop_toBottomOf="@id/report_summary" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
