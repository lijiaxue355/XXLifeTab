<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="66dp">

    <include layout="@layout/view_editor_steps_base" />

    <View
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="17dp"
        android:background="@color/lifelab_primary"
        app:layout_constraintBottom_toBottomOf="@id/base_line_1_2"
        app:layout_constraintEnd_toStartOf="@id/base_step_2"
        app:layout_constraintStart_toEndOf="@id/base_step_1"
        app:layout_constraintTop_toTopOf="@id/base_line_1_2" />

    <TextView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_editor_step_active"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/base_step_1"
        app:layout_constraintEnd_toEndOf="@id/base_step_1"
        app:layout_constraintStart_toStartOf="@id/base_step_1"
        app:layout_constraintTop_toTopOf="@id/base_step_1" />

    <TextView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_editor_step_active"
        android:gravity="center"
        android:text="2"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/base_step_2"
        app:layout_constraintEnd_toEndOf="@id/base_step_2"
        app:layout_constraintStart_toStartOf="@id/base_step_2"
        app:layout_constraintTop_toTopOf="@id/base_step_2" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/lifelab_background"
        android:text="@string/step_schedule"
        android:textColor="@color/lifelab_primary_dark"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/base_step_2"
        app:layout_constraintStart_toStartOf="@id/base_step_2"
        app:layout_constraintTop_toBottomOf="@id/base_step_2" />
</androidx.constraintlayout.widget.ConstraintLayout>
