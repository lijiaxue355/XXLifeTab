<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/base_line_1_2"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginStart="17dp"
        android:layout_marginTop="21dp"
        android:layout_marginEnd="17dp"
        android:background="@color/lifelab_divider"
        app:layout_constraintEnd_toStartOf="@id/base_step_2"
        app:layout_constraintStart_toEndOf="@id/base_step_1"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/base_line_2_3"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginStart="17dp"
        android:layout_marginTop="21dp"
        android:layout_marginEnd="17dp"
        android:background="@color/lifelab_divider"
        app:layout_constraintEnd_toStartOf="@id/base_step_3"
        app:layout_constraintStart_toEndOf="@id/base_step_2"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/base_line_3_4"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginStart="17dp"
        android:layout_marginTop="21dp"
        android:layout_marginEnd="17dp"
        android:background="@color/lifelab_divider"
        app:layout_constraintEnd_toStartOf="@id/base_step_4"
        app:layout_constraintStart_toEndOf="@id/base_step_3"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/base_step_1"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_editor_step_inactive"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/lifelab_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/base_step_2"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/base_step_2"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_editor_step_inactive"
        android:gravity="center"
        android:text="2"
        android:textColor="@color/lifelab_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/base_step_3"
        app:layout_constraintStart_toEndOf="@id/base_step_1"
        app:layout_constraintTop_toTopOf="@id/base_step_1" />

    <TextView
        android:id="@+id/base_step_3"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_editor_step_inactive"
        android:gravity="center"
        android:text="3"
        android:textColor="@color/lifelab_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/base_step_4"
        app:layout_constraintStart_toEndOf="@id/base_step_2"
        app:layout_constraintTop_toTopOf="@id/base_step_1" />

    <TextView
        android:id="@+id/base_step_4"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="26dp"
        android:background="@drawable/bg_editor_step_inactive"
        android:gravity="center"
        android:text="4"
        android:textColor="@color/lifelab_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/base_step_3"
        app:layout_constraintTop_toTopOf="@id/base_step_1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/step_basic"
        android:textColor="@color/lifelab_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/base_step_1"
        app:layout_constraintStart_toStartOf="@id/base_step_1"
        app:layout_constraintTop_toBottomOf="@id/base_step_1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/step_schedule"
        android:textColor="@color/lifelab_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/base_step_2"
        app:layout_constraintStart_toStartOf="@id/base_step_2"
        app:layout_constraintTop_toBottomOf="@id/base_step_2" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/step_metrics"
        android:textColor="@color/lifelab_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/base_step_3"
        app:layout_constraintStart_toStartOf="@id/base_step_3"
        app:layout_constraintTop_toBottomOf="@id/base_step_3" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/step_preview"
        android:textColor="@color/lifelab_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/base_step_4"
        app:layout_constraintStart_toStartOf="@id/base_step_4"
        app:layout_constraintTop_toBottomOf="@id/base_step_4" />
</merge>
